PRAESIDIUM_CELERY_RESULT_BACKEND=redis://:CHANGE_ME@127.0.0.1:6379/1
PRAESIDIUM_AMQP_URL=amqp://admin:CHANGE_ME@127.0.0.1:5672/%2F
